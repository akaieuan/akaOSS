{
  "name": "akaoss",
  "version": "0.1.0",
  "private": true,
  "description": "akaOSS — the studio site at akaoss.dev: five open-source projects for human-in-the-loop AI measurement and developer tooling, plus the research feed and the HITL Kit component registry.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "hitl:sync": "node scripts/hitl-sync.mjs",
    "hitl:check": "node scripts/hitl-sync.mjs --check",
    "verify": "pnpm typecheck && pnpm hitl:check && pnpm facts:check && pnpm build",
    "smoke-test": "bash scripts/smoke-test.sh local",
    "smoke-test:prod": "bash scripts/smoke-test.sh prod",
    "facts:build": "tsx scripts/facts.ts",
    "facts:check": "pnpm facts:build && git diff --exit-code facts.json && echo \"✓ facts up to date\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.8.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^4.1.2",
      "postcss": "^8.5.10",
      "ip-address": "^10.3.1",
      "brace-expansion": "^2.1.4",
      "qs": "^6.15.2",
      "sharp": ">=0.35.0",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "undici": "^7.29.0",
      "nanoid@3": "^3.3.17",
      "browserslist": ">=4.28.7"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}
